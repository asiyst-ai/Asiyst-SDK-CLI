{
  "name": "@asiyst/cli",
  "version": "1.1.0",
  "description": "Connect a local website project to Asiyst",
  "license": "MIT",
  "type": "module",
  "bin": {
    "asiyst": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/asiyst-ai/Asiyst-SDK-CLI.git",
    "directory": "packages/cli"
  },
  "homepage": "https://asiyst.com",
  "bugs": {
    "url": "https://github.com/asiyst-ai/Asiyst-SDK-CLI/issues"
  },
  "keywords": [
    "asiyst",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
